+                float P[3][NMEL + 2];
+                for (int dt = 0; dt < 3; dt++) {
+                    const int ti = 2 * r - 1 + dt;
+                    P[dt][0] = 0.f;
+                    P[dt][NMEL + 1] = 0.f;
