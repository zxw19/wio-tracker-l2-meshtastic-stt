+
+namespace
+{
+lv_obj_t *micButton = nullptr;
+lv_obj_t *micLabel = nullptr;
+lv_obj_t *confirmBar = nullptr;
+lv_obj_t *confirmLabel = nullptr;
+bool uiReady = false;
+bool recording = false;
+bool confirmShown = false;
+int shownTenths = -1;
+uint32_t shownRev = 0;
+
+void styleButton(lv_obj_t *btn, bool rec)
+{
+    lv_obj_set_style_bg_color(btn, lv_color_hex(rec ? 0xC62828 : 0x1E3A8A), 0);
+    // Faint while idle so it does not compete with the page, solid while recording.
+    lv_obj_set_style_bg_opa(btn, rec ? LV_OPA_COVER : LV_OPA_60, 0);
+    lv_obj_set_style_border_color(btn, lv_color_hex(rec ? 0xFF8A80 : 0x93C5FD), 0);
+}
+
+void onMicEvent(lv_event_t *e)
+{
+    if (!speechToTextModule)
+        return;
+
+    switch (lv_event_get_code(e)) {
+    case LV_EVENT_PRESSED:
+        speechToTextModule->startCapture();
+        break;
+    case LV_EVENT_RELEASED:
+    case LV_EVENT_PRESS_LOST:
+        speechToTextModule->stopCapture();
+        break;
+    default:
+        break;
+    }
+}
+
+void onConfirmEvent(lv_event_t *e)
+{
+    if (!speechToTextModule)
+        return;
+    if (lv_event_get_user_data(e) == (void *)1)
+        speechToTextModule->confirmPending();
+    else
+        speechToTextModule->discardPending();
+}
+
+lv_obj_t *makeBarButton(lv_obj_t *parent, const char *text, uint32_t color, int xRight)
+{
+    lv_obj_t *btn = lv_button_create(parent);
+    lv_obj_set_size(btn, 60, 44);
+    lv_obj_align(btn, LV_ALIGN_RIGHT_MID, xRight, 0);
+    lv_obj_set_style_radius(btn, 8, 0);
+    lv_obj_set_style_bg_color(btn, lv_color_hex(color), 0);
+    lv_obj_set_style_bg_opa(btn, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(btn, 0, 0);
+
+    lv_obj_t *label = lv_label_create(btn);
+    lv_label_set_text(label, text);
+    lv_obj_set_style_text_color(label, lv_color_white(), 0);
+    lv_obj_center(label);
+    return btn;
+}
+
+void createMicButton()
+{
+    // Small and on the right edge: the bottom strip of the TFT view is the navigation bar, and a
+    // big floating button there hides it.
+    lv_obj_t *btn = lv_obj_create(lv_layer_top());
+    lv_obj_set_size(btn, 46, 46);
+    lv_obj_align(btn, LV_ALIGN_RIGHT_MID, -6, 0);
+    lv_obj_set_style_radius(btn, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_border_width(btn, 2, 0);
+    lv_obj_set_style_shadow_width(btn, 4, 0);
+    lv_obj_set_style_shadow_opa(btn, LV_OPA_30, 0);
+    lv_obj_set_style_pad_all(btn, 0, 0);
+    lv_obj_remove_flag(btn, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(btn, LV_OBJ_FLAG_CLICKABLE);
+    styleButton(btn, false);
+
+    lv_obj_t *label = lv_label_create(btn);
+    lv_label_set_text(label, "MIC");
+    lv_obj_set_style_text_color(label, lv_color_white(), 0);
+    lv_obj_center(label);
+
+    lv_obj_add_event_cb(btn, onMicEvent, LV_EVENT_PRESSED, nullptr);
+    lv_obj_add_event_cb(btn, onMicEvent, LV_EVENT_RELEASED, nullptr);
+    lv_obj_add_event_cb(btn, onMicEvent, LV_EVENT_PRESS_LOST, nullptr);
+
+    micButton = btn;
+    micLabel = label;
+    LOG_INFO("STT UI: mic button on the top layer (right edge)");
+}
+
+void createConfirmBar()
+{
+    lv_obj_t *bar = lv_obj_create(lv_layer_top());
+    lv_obj_set_size(bar, 300, 64);
+    lv_obj_align(bar, LV_ALIGN_BOTTOM_MID, 0, -52);
+    lv_obj_set_style_radius(bar, 10, 0);
+    lv_obj_set_style_bg_color(bar, lv_color_hex(0x111827), 0);
+    lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(bar, 1, 0);
+    lv_obj_set_style_border_color(bar, lv_color_hex(0x3B82F6), 0);
+    lv_obj_set_style_pad_all(bar, 0, 0);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(bar, LV_OBJ_FLAG_HIDDEN);
+
+    lv_obj_t *label = lv_label_create(bar);
+    lv_obj_set_width(label, 150);
+    lv_label_set_long_mode(label, LV_LABEL_LONG_MODE_WRAP);
+    lv_label_set_text(label, "");
+    lv_obj_set_style_text_color(label, lv_color_white(), 0);
+    lv_obj_set_style_text_align(label, LV_TEXT_ALIGN_LEFT, 0);
+    lv_obj_align(label, LV_ALIGN_LEFT_MID, 10, 0);
+
+    lv_obj_t *redo = makeBarButton(bar, "REDO", 0x334155, -78);
+    lv_obj_t *send = makeBarButton(bar, "SEND", 0x15803D, -10);
+    lv_obj_add_event_cb(redo, onConfirmEvent, LV_EVENT_CLICKED, (void *)2);
+    lv_obj_add_event_cb(send, onConfirmEvent, LV_EVENT_CLICKED, (void *)1);
+
+    confirmBar = bar;
+    confirmLabel = label;
+    LOG_INFO("STT UI: confirm bar created (SEND / REDO)");
+}
+} // namespace
+
+void sttTouchUiTick(void)
+{
+    if (!speechToTextModule || !speechToTextModule->isUiReady())
+        return;
+
+    if (!uiReady) {
+        if (!lv_display_get_default())
+            return;
+        createMicButton();
+        createConfirmBar();
+        uiReady = true;
+    }
+
+    const bool rec = speechToTextModule->isCapturing();
+    if (rec != recording) {
+        recording = rec;
+        shownTenths = -1;
+        styleButton(micButton, rec);
+        if (!rec) {
+            lv_label_set_text(micLabel, "MIC");
+            shownTenths = 0;
+        }
+    }
+
+    if (rec) {
+        // Only seconds fit in a 46 px circle; the 8 s cap is what the user needs to see.
+        int tenths = (int)(speechToTextModule->captureElapsedMs() / 100);
+        if (tenths != shownTenths) {
+            shownTenths = tenths;
+            char buf[8];
+            snprintf(buf, sizeof(buf), "%ds", tenths / 10);
+            lv_label_set_text(micLabel, buf);
+        }
+    }
+
+    const bool pending = speechToTextModule->pendingValid();
+    const uint32_t rev = speechToTextModule->pendingRevision();
+    if (pending && (!confirmShown || rev != shownRev)) {
+        shownRev = rev;
+        lv_label_set_text(confirmLabel, speechToTextModule->pendingText());
+    }
+    if (pending != confirmShown) {
+        confirmShown = pending;
+        if (pending)
+            lv_obj_remove_flag(confirmBar, LV_OBJ_FLAG_HIDDEN);
+        else
+            lv_obj_add_flag(confirmBar, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+#endif
