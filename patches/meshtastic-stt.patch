+#pragma once
+#if defined(ARCH_ESP32) && defined(SEEED_WIO_TRACKER_L2) && defined(HAS_TFT) && !defined(MESHTASTIC_EXCLUDE_STT)
+
+#include "concurrency/OSThread.h"
+#include "platform/esp32/L2AudioInput.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include <stddef.h>
+#include <stdint.h>
+
+#define STT_TEXT_BYTES 512
+#define STT_MAX_UTTERANCE_SEC 8
+// Show the transcript with SEND / REDO before it goes out, so a bad decode never hits the channel.
+#define STT_CONFIRM_BEFORE_SEND 1
+
+struct tasr_nemo;
+
+/**
+ * On-device speech to text: runs the Oido NeMo Conformer-CTC int8 engine over 16 kHz mono PCM.
+ *
+ * Model weights live in a raw flash partition named "model" (see default_16MB_stt.csv) and are memory
+ * mapped, so they cost no RAM. Engine scratch buffers go through the tasr_alloc hook: kind 1 (hot) to
+ * internal SRAM, kind 0 (bulk) to PSRAM.
+ *
+ * Bring-up runs once shortly after boot: load the engine, transcribe the clip bundled in LittleFS at
+ * /stt/test_en.wav, then start the microphone. Afterwards holding the user button talks.
+ */
+class SpeechToTextModule : public concurrency::OSThread
+{
+  public:
+    SpeechToTextModule();
+    static SpeechToTextModule *instance;
+
+    bool isReady() const { return nemo != nullptr; }
+    bool isMicReady() const { return audioInput.isRunning(); }
+    /// True once bring-up finished (successfully or not); the UI waits for this so creating the
+    /// button does not overlap the I2C traffic of the microphone probe.
+    bool isUiReady() const { return bringUpDone; }
+    const char *lastTranscript() const { return lastText; }
+    float lastRealTimeFactor() const { return lastRtf; }
+
+    /// Transcribe 16 kHz mono PCM16. Returns the transcript length written to out, 0 on failure.
+    int transcribe(const int16_t *pcm, int samples, char *out, int outLen);
+
+    /// Queue another bring-up / self test pass.
+    void runSelfTest() { selfTestPending = true; }
+
+    /// Start / stop recording. Both return immediately: capture runs on its own task so the LVGL
+    /// thread and the mesh stack keep running while the user holds the button.
+    void startCapture();
+    void stopCapture();
+    bool isCapturing() const { return captureActive; }
+    /// Milliseconds since the current recording started (0 when idle), for the on-screen timer.
+    uint32_t captureElapsedMs() const;
+
+    /// Transcript waiting for SEND / REDO. confirmPending() and discardPending() only set a flag;
+    /// the actual mesh send happens on the module thread.
+    bool pendingValid() const { return pendingFlag; }
+    const char *pendingText() const { return pendingTranscript; }
+    uint32_t pendingRevision() const { return pendingRev; }
+    void confirmPending() { pendingAction = 1; }
+    void discardPending() { pendingAction = 2; }
+
+  protected:
+    int32_t runOnce() override;
+
+  private:
+    void bringUp();
+    bool loadEngine();
+    int transcribeWavFile(const char *path);
+    void sendTranscript(const char *text);
+    int transcribeInline(const int16_t *pcm, int samples, char *out, int outLen);
+    static void decodeTaskEntry(void *arg);
+    void decodeLoop();
+    bool startDecodeWorker();
+    static void captureTaskEntry(void *arg);
+    void captureLoop();
+    bool startCaptureWorker();
+
+    bool selfTestPending = true;
+    volatile bool bringUpDone = false;
+    volatile uint32_t nextMicRetryMs = 0;
+    int micRetryCount = 0;
+    bool buttonDown = false;
+    uint32_t lastReleaseMs = 0;
+    struct tasr_nemo *nemo = nullptr;
+    const void *modelBlob = nullptr;
+    size_t modelSize = 0;
+    float lastRtf = 0.0f;
+    int16_t *captureBuf = nullptr;
+    L2AudioInput audioInput;
+    char lastText[STT_TEXT_BYTES] = {0};
+
+    // Microphone capture runs on its own task. Blocking a whole loop iteration for up to 8 s used to
+    // stall both the UI and the radio, so the key / touch handler now only flips flags.
+    TaskHandle_t captureTask = nullptr;
+    SemaphoreHandle_t captureWake = nullptr;
+    volatile bool captureActive = false;
+    volatile bool captureBusy = false;
+    volatile int captureSamples = 0;
+    volatile uint32_t captureStartedMs = 0;
+
+    // Decoded text held back until the user confirms it on screen.
+    char pendingTranscript[STT_TEXT_BYTES] = {0};
+    volatile bool pendingFlag = false;
+    volatile uint32_t pendingRev = 0;
+    volatile int pendingAction = 0; // 1 = send, 2 = discard
+
+    // Decoding runs on its own task: tasr_nemo_transcribe() needs more stack than the 8 KB
+    // loopTask has. The worker is pinned to core 0 so mesh/LoRa on core 1 is untouched.
+    TaskHandle_t decodeTask = nullptr;
+    SemaphoreHandle_t decodeStart = nullptr;
+    SemaphoreHandle_t decodeDone = nullptr;
+    const int16_t *jobPcm = nullptr;
+    int jobSamples = 0;
+    char *jobOut = nullptr;
+    int jobOutLen = 0;
+    int jobResult = 0;
+};
+
+extern SpeechToTextModule *speechToTextModule;
+
+#endif
