diff --git a/src/platform/esp32/L2AudioInput.cpp b/src/platform/esp32/L2AudioInput.cpp
new file mode 100644
index 0000000..1521ccf
--- /dev/null
+++ b/src/platform/esp32/L2AudioInput.cpp
@@ -0,0 +1,233 @@
+#include "configuration.h"
+#if defined(ARCH_ESP32) && defined(SEEED_WIO_TRACKER_L2) && defined(HAS_TFT) && !defined(MESHTASTIC_EXCLUDE_STT)
+
+#include "L2AudioInput.h"
+#include "DebugConfiguration.h"
+#include <Wire.h>
+#include <stdio.h>
+#include "driver/i2s.h"
+#include <string.h>
+
+#define STT_ADC_ADDR ES7243E_ADDR
+#define STT_SAMPLE_RATE 16000
+#define STT_SLOT_BYTES 4
+#define STT_DMA_FRAMES 256
+
+// Verbatim ES7243E bring-up sequence from audio-driver's Codecs/es7243e/ES7243E.h
+static const uint8_t es7243eInit[][2] = {
+    {0x01, 0x3A}, {0x00, 0x80}, {0xF9, 0x00}, {0x04, 0x02}, {0x04, 0x01}, {0xF9, 0x01}, {0x00, 0x1E}, {0x01, 0x00},
+    {0x02, 0x00}, {0x03, 0x20}, {0x04, 0x01}, {0x0D, 0x00}, {0x05, 0x00}, {0x06, 0x03}, {0x07, 0x00}, {0x08, 0xFF},
+    {0x09, 0xCA}, {0x0A, 0x85}, {0x0B, 0x00}, {0x0E, 0xBF}, {0x0F, 0x80}, {0x14, 0x0C}, {0x15, 0x0C}, {0x17, 0x02},
+    {0x18, 0x26}, {0x19, 0x77}, {0x1A, 0xF4}, {0x1B, 0x66}, {0x1C, 0x44}, {0x1E, 0x00}, {0x1F, 0x0C}, {0x20, 0x1A},
+    {0x21, 0x1A}, {0x00, 0x80}, {0x01, 0x3A}, {0x16, 0x3F}, {0x16, 0x00},
+};
+
+// The GT911 touch controller is driven by LovyanGFX's own register level I2C code on the same
+// port, from the LVGL task, with no shared lock. A write issued while that transaction is in flight
+// comes back ESP_ERR_INVALID_STATE, so each register gets a few attempts and the bus gets rebuilt
+// once if the whole sequence still fails.
+static bool es7243eWrite(uint8_t reg, uint8_t value)
+{
+    for (int attempt = 0; attempt < 3; attempt++) {
+        Wire.beginTransmission(STT_ADC_ADDR);
+        Wire.write(reg);
+        Wire.write(value);
+        if (Wire.endTransmission() == 0)
+            return true;
+        delay(2);
+    }
+    return false;
+}
+
+static bool es7243ePing()
+{
+    Wire.beginTransmission(STT_ADC_ADDR);
+    return Wire.endTransmission() == 0;
+}
+
+static void i2cRecover()
+{
+    Wire.end();
+    delay(5);
+    Wire.begin(I2C_SDA, I2C_SCL);
+    delay(10);
+}
+
+static bool es7243eProgram()
+{
+    for (size_t i = 0; i < sizeof(es7243eInit) / sizeof(es7243eInit[0]); i++) {
+        if (!es7243eWrite(es7243eInit[i][0], es7243eInit[i][1])) {
+            LOG_WARN("STT mic: ES7243E write failed at reg 0x%02x", (unsigned)es7243eInit[i][0]);
+            return false;
+        }
+    }
+    return true;
+}
+
+bool L2AudioInput::begin()
+{
+    if (running)
+        return true;
+
+    if (!es7243ePing()) {
+        LOG_WARN("STT mic: ES7243E did not answer, rebuilding the I2C bus once");
+        i2cRecover();
+        if (!es7243ePing()) {
+            LOG_ERROR("STT mic: no ES7243E at 0x%02x on Wire", (unsigned)STT_ADC_ADDR);
+            return false;
+        }
+    }
+
+    if (!es7243eProgram()) {
+        LOG_WARN("STT mic: ES7243E init failed, rebuilding the I2C bus and retrying");
+        i2cRecover();
+        if (!es7243eProgram()) {
+            LOG_ERROR("STT mic: ES7243E unavailable after bus recovery");
+            return false;
+        }
+    }
+    LOG_INFO("STT mic: ES7243E configured at 0x%02x", STT_ADC_ADDR);
+
+    // The firmware already links the legacy ESP-IDF I2S driver through ESP8266Audio: AudioThread
+    // drives the ES8311 speaker on I2S_NUM_1. IDF aborts at boot if the new i2s_std driver is
+    // linked alongside the legacy one, so microphone capture uses the legacy API on I2S_NUM_0.
+    // ES7243E fixes SCLK = MCLK/4 and LRCK = MCLK/256, so 16 kHz means 4.096 MHz MCLK with
+    // 32 bit slots. Samples are 24 bit left justified; keep the top 16 bits.
+    i2s_config_t cfg = {};
+    cfg.mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX);
+    cfg.sample_rate = STT_SAMPLE_RATE;
+    cfg.bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT;
+    cfg.channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT;
+    cfg.communication_format = I2S_COMM_FORMAT_STAND_I2S;
+    cfg.intr_alloc_flags = 0;
+    cfg.dma_buf_count = 8;
+    cfg.dma_buf_len = STT_DMA_FRAMES;
+    cfg.use_apll = false;
+    cfg.tx_desc_auto_clear = false;
+    cfg.fixed_mclk = 0;
+
+    esp_err_t err = i2s_driver_install(I2S_NUM_0, &cfg, 0, nullptr);
+    if (err != ESP_OK) {
+        LOG_ERROR("STT mic: i2s_driver_install(I2S_NUM_0) failed (0x%x)", (unsigned)err);
+        return false;
+    }
+
+    i2s_pin_config_t pins = {};
+    pins.mck_io_num = ADC_I2S_MCLK;
+    pins.bck_io_num = ADC_I2S_BCK;
+    pins.ws_io_num = ADC_I2S_WS;
+    pins.data_out_num = I2S_PIN_NO_CHANGE;
+    pins.data_in_num = ADC_I2S_DIN;
+
+    err = i2s_set_pin(I2S_NUM_0, &pins);
+    if (err != ESP_OK) {
+        LOG_ERROR("STT mic: i2s_set_pin failed (0x%x)", (unsigned)err);
+        i2s_driver_uninstall(I2S_NUM_0);
+        return false;
+    }
+
+    i2s_zero_dma_buffer(I2S_NUM_0);
+    rxChannel = (void *)1;
+    running = true;
+    peak = 0;
+    LOG_INFO("STT mic: I2S0 RX up, %d Hz, MCLK %d Hz, BCK %d Hz, 32 bit slots", STT_SAMPLE_RATE,
+             STT_SAMPLE_RATE * 256, STT_SAMPLE_RATE * 64);
+    return true;
+}
+
+void L2AudioInput::end()
+{
+    if (!running)
+        return;
+    i2s_driver_uninstall(I2S_NUM_0);
+    rxChannel = nullptr;
+    running = false;
+}
+
+void L2AudioInput::flush()
+{
+    if (!running)
+        return;
+    i2s_zero_dma_buffer(I2S_NUM_0);
+    peak = 0;
+}
+
+int L2AudioInput::read(int16_t *out, int samples, uint32_t timeoutMs)
+{
+    if (!running || !out || samples <= 0)
+        return 0;
+
+    static int32_t slot[STT_DMA_FRAMES * 2];
+    int got = 0;
+
+    while (got < samples) {
+        int frames = samples - got;
+        if (frames > STT_DMA_FRAMES)
+            frames = STT_DMA_FRAMES;
+        size_t bytesRead = 0;
+        uint32_t wait = timeoutMs ? timeoutMs : 1;
+        if (i2s_read(I2S_NUM_0, slot, (size_t)frames * 2 * STT_SLOT_BYTES, &bytesRead, wait) != ESP_OK)
+            break;
+        int n = (int)(bytesRead / (2 * STT_SLOT_BYTES));
+        if (n <= 0)
+            break;
+        for (int i = 0; i < n && got < samples; i++) {
+            int16_t a = (int16_t)(slot[i * 2] >> 16);
+            int16_t b = (int16_t)(slot[i * 2 + 1] >> 16);
+            int magA = a < 0 ? -(int)a : (int)a;
+            int magB = b < 0 ? -(int)b : (int)b;
+            if (magA > (int)peakSlotA)
+                peakSlotA = (int16_t)(magA > 32767 ? 32767 : magA);
+            if (magB > (int)peakSlotB)
+                peakSlotB = (int16_t)(magB > 32767 ? 32767 : magB);
+            int mag = magA >= magB ? magA : magB;
+            if (mag > (int)peak)
+                peak = (int16_t)(mag > 32767 ? 32767 : mag);
+            // A mono codec drives only one slot; take whichever one actually carries audio so the
+            // frame layout can not silently drop the microphone.
+            out[got++] = magA >= magB ? a : b;
+        }
+    }
+    return got;
+}
+
+int16_t L2AudioInput::takePeak()
+{
+    int16_t p = peak;
+    peak = 0;
+    peakSlotA = 0;
+    peakSlotB = 0;
+    return p;
+}
+
+void L2AudioInput::takePeaks(int16_t &slotA, int16_t &slotB)
+{
+    slotA = peakSlotA;
+    slotB = peakSlotB;
+    peak = 0;
+    peakSlotA = 0;
+    peakSlotB = 0;
+}
+
+void L2AudioInput::logRawFrames(int frames)
+{
+    if (!running || frames <= 0)
+        return;
+    if (frames > 32)
+        frames = 32;
+
+    static int32_t buf[64];
+    size_t bytesRead = 0;
+    if (i2s_read(I2S_NUM_0, buf, (size_t)frames * 2 * STT_SLOT_BYTES, &bytesRead, 100) != ESP_OK)
+        return;
+
+    int n = (int)(bytesRead / (2 * STT_SLOT_BYTES));
+    int shown = n < 3 ? n : 3;
+    char line[200];
+    int pos = 0;
+    for (int i = 0; i < shown && pos < (int)sizeof(line) - 26; i++)
+        pos += snprintf(line + pos, sizeof(line) - pos, " [%08X %08X]", (unsigned)buf[i * 2], (unsigned)buf[i * 2 + 1]);
+    LOG_INFO("STT mic: raw frame slots:%s", line);
+}
+
+#endif
diff --git a/src/platform/esp32/L2AudioInput.h b/src/platform/esp32/L2AudioInput.h
new file mode 100644
index 0000000..353a1d0
--- /dev/null
+++ b/src/platform/esp32/L2AudioInput.h
@@ -0,0 +1,46 @@
+#pragma once
+#if defined(ARCH_ESP32) && defined(SEEED_WIO_TRACKER_L2) && defined(HAS_TFT) && !defined(MESHTASTIC_EXCLUDE_STT)
+
+#include <stddef.h>
+#include <stdint.h>
+
+/**
+ * 16 kHz mono capture from the ES7243E microphone ADC.
+ *
+ * The ES7243E is a slave on the I2S bus shared with the ES8311 (BCK 11, WS 12, MCLK 10, data in 15).
+ * Its init sequence fixes SCLK = MCLK/4 and LRCK = MCLK/256, so at a 16 kHz sample rate the ESP32 must
+ * master 4.096 MHz MCLK and 1.024 MHz BCK, i.e. 16 bit samples carried in 32 bit slots.
+ */
+class L2AudioInput
+{
+  public:
+    bool begin();
+    void end();
+    bool isRunning() const { return running; }
+
+    /// Read up to `samples` mono 16 bit samples, blocking at most timeoutMs per DMA read.
+    int read(int16_t *out, int samples, uint32_t timeoutMs);
+
+    /// Drop buffered audio (disable/re-enable the DMA channel). Call just before an utterance starts.
+    void flush();
+
+    /// Peak absolute sample seen since the last call, to tell signal from silence or miswiring.
+    int16_t takePeak();
+
+    /// Per-slot peaks since the last call. A mono codec only drives one of the two 32 bit words in
+    /// each I2S frame, so knowing which slot carries the signal is the fastest way to spot a
+    /// channel/alignment mistake.
+    void takePeaks(int16_t &slotA, int16_t &slotB);
+
+    /// Log the raw 32 bit words of a few frames (hex) to check bit alignment.
+    void logRawFrames(int frames);
+
+  private:
+    bool running = false;
+    void *rxChannel = nullptr;
+    volatile int16_t peak = 0;
+    volatile int16_t peakSlotA = 0;
+    volatile int16_t peakSlotB = 0;
+};
+
+#endif
\ No newline at end of file
