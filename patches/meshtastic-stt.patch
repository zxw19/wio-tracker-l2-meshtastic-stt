+
+#include "tasr_nemo.h"
+#include "tinyasr.h"
+
+SpeechToTextModule *speechToTextModule;
+SpeechToTextModule *SpeechToTextModule::instance;
+
+#define STT_MODEL_LABEL "model"
+#define STT_TEST_CLIP "/stt/test_en.wav"
+#define STT_CLIP_MAX_BYTES (512 * 1024)
+#define STT_CPU_HZ 240000000.0f
+#define STT_MIN_UTTERANCE_SAMPLES 4800
+#define STT_READ_CHUNK 1600
+#define STT_BRINGUP_DELAY_MS 20000
+#define STT_MIC_RETRIES 8
+// loopTask only has 8 KB and the NeMo decode chain overflows it, so decode gets its own task.
+#define STT_DECODE_STACK_BYTES 16384
+
+static esp_partition_mmap_handle_t modelMmapHandle;
+
+extern "C" {
+
+void *sttAlloc(size_t size, int kind)
+{
+    size_t n = size ? size : 16;
+    uint32_t caps = MALLOC_CAP_8BIT | (kind == 1 ? MALLOC_CAP_INTERNAL : MALLOC_CAP_SPIRAM);
+    void *p = heap_caps_aligned_alloc(16, n, caps);
+    if (!p && (caps & MALLOC_CAP_INTERNAL))
+        p = heap_caps_aligned_alloc(16, n, MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
+    if (p)
+        memset(p, 0, n);
+    return p;
+}
+
+void sttFree(void *p)
+{
+    heap_caps_free(p);
+}
+
+} // extern "C"
+
+static void sttLogMemory(const char *when)
+{
+    LOG_INFO("STT mem %s: internal free %u largest %u, PSRAM free %u", when,
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+}
+
+SpeechToTextModule::SpeechToTextModule() : OSThread("SpeechToText")
+{
+    speechToTextModule = this;
+    instance = this;
+    setIntervalFromNow(STT_BRINGUP_DELAY_MS);
+    LOG_INFO("STT: armed, bring-up in %d ms", STT_BRINGUP_DELAY_MS);
+}
+
+bool SpeechToTextModule::loadEngine()
+{
+    if (nemo)
+        return true;
+
+    const esp_partition_t *part =
+        esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, STT_MODEL_LABEL);
+    if (!part) {
+        LOG_ERROR("STT: no '%s' partition - was default_16MB_stt.csv flashed?", STT_MODEL_LABEL);
+        return false;
+    }
+    LOG_INFO("STT: '%s' partition at 0x%06x, %u bytes", part->label, (unsigned)part->address, (unsigned)part->size);
+
+    esp_err_t err = esp_partition_mmap(part, 0, part->size, ESP_PARTITION_MMAP_DATA, &modelBlob, &modelMmapHandle);
+    if (err != ESP_OK || !modelBlob) {
+        LOG_ERROR("STT: mmap of '%s' partition failed (0x%x)", STT_MODEL_LABEL, (unsigned)err);
+        return false;
+    }
+    modelSize = part->size;
+
+    tasr_alloc = sttAlloc;
+    tasr_free = sttFree;
+
+    sttLogMemory("before load");
+    nemo = tasr_nemo_load((const uint8_t *)modelBlob, modelSize);
+    if (!nemo) {
+        LOG_ERROR("STT: tasr_nemo_load failed - is oido_v2b.tnm (magic TNM1) in this partition?");
+        modelBlob = nullptr;
+        modelSize = 0;
+        return false;
+    }
+    sttLogMemory("after load");
+    LOG_INFO("STT: engine ready, blob %u bytes, weights %u bytes, streaming %s", (unsigned)tasr_nemo_blob_bytes(nemo),
+             (unsigned)tasr_nemo_weight_bytes(nemo), tasr_nemo_stream_supported(nemo) ? "supported" : "unsupported");
+    return true;
+}
+
+void SpeechToTextModule::decodeTaskEntry(void *arg)
+{
+    static_cast<SpeechToTextModule *>(arg)->decodeLoop();
+}
+
+void SpeechToTextModule::decodeLoop()
+{
+    for (;;) {
+        if (xSemaphoreTake(decodeStart, portMAX_DELAY) != pdTRUE)
+            continue;
+        jobResult = transcribeInline(jobPcm, jobSamples, jobOut, jobOutLen);
+        xSemaphoreGive(decodeDone);
+    }
+}
+
+bool SpeechToTextModule::startDecodeWorker()
+{
+    if (decodeTask)
+        return true;
+
+    decodeStart = xSemaphoreCreateBinary();
+    decodeDone = xSemaphoreCreateBinary();
+    if (!decodeStart || !decodeDone)
+        return false;
+
+    if (xTaskCreatePinnedToCore(decodeTaskEntry, "stt_decode", STT_DECODE_STACK_BYTES, this, 1, &decodeTask, 0) !=
+        pdPASS) {
+        decodeTask = nullptr;
+        return false;
+    }
+    LOG_INFO("STT: decode worker up on core 0 (%d byte stack)", STT_DECODE_STACK_BYTES);
+    return true;
+}
+
+int SpeechToTextModule::transcribe(const int16_t *pcm, int samples, char *out, int outLen)
+{
+    if (!nemo || !pcm || samples <= 0 || !out || outLen <= 0)
+        return 0;
+
+    if (decodeTask && decodeStart && decodeDone) {
+        jobPcm = pcm;
+        jobSamples = samples;
+        jobOut = out;
+        jobOutLen = outLen;
+        if (xSemaphoreGive(decodeStart) == pdTRUE && xSemaphoreTake(decodeDone, pdMS_TO_TICKS(60000)) == pdTRUE)
+            return jobResult;
+        LOG_ERROR("STT: decode worker did not answer in 60 s");
+        return 0;
+    }
+
+    return transcribeInline(pcm, samples, out, outLen);
+}
+
+int SpeechToTextModule::transcribeInline(const int16_t *pcm, int samples, char *out, int outLen)
+{
+    out[0] = '\0';
+
+    sttLogMemory("before decode");
+    uint32_t start = esp_cpu_get_cycle_count();
+    int frames = tasr_nemo_transcribe(nemo, pcm, samples, nullptr, out, outLen, nullptr, 0, nullptr);
+    uint32_t elapsed = esp_cpu_get_cycle_count() - start;
+    sttLogMemory("after decode");
+
+    float audioSec = (float)samples / 16000.0f;
+    float cpuSec = (float)elapsed / STT_CPU_HZ;
+    lastRtf = audioSec > 0.0f ? cpuSec / audioSec : 0.0f;
+    LOG_INFO("STT: %d encoder frames, %.2f s audio decoded in %.2f s cpu (RTF %.2f)", frames, audioSec, cpuSec,
+             lastRtf);
+    return (int)strlen(out);
+}
+
+int SpeechToTextModule::transcribeWavFile(const char *path)
+{
+    if (!FSCom.exists(path)) {
+        LOG_WARN("STT: %s not in LittleFS, skipping clip test", path);
+        return -1;
+    }
+    File f = FSCom.open(path, FILE_O_READ);
+    if (!f) {
+        LOG_ERROR("STT: cannot open %s", path);
+        return -1;
+    }
+    size_t len = f.size();
+    if (len < 44 || len > STT_CLIP_MAX_BYTES) {
+        f.close();
+        LOG_ERROR("STT: %s has unusable size %u", path, (unsigned)len);
+        return -1;
+    }
+    uint8_t *raw = (uint8_t *)heap_caps_aligned_alloc(16, len + 16, MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
+    if (!raw) {
+        f.close();
+        LOG_ERROR("STT: cannot allocate %u bytes for %s", (unsigned)len, path);
+        return -1;
+    }
+    size_t got = f.read(raw, len);
+    f.close();
+
+    int channels = 0, rate = 0, bits = 0;
+    const int16_t *pcm = nullptr;
+    int samples = 0;
+    if (got >= 44 && !memcmp(raw, "RIFF", 4) && !memcmp(raw + 8, "WAVE", 4)) {
+        size_t p = 12;
+        while (p + 8 <= got) {
+            uint32_t clen;
+            memcpy(&clen, raw + p + 4, 4);
+            if (!memcmp(raw + p, "fmt ", 4)) {
+                channels = raw[p + 10] | (raw[p + 11] << 8);
+                rate = raw[p + 12] | (raw[p + 13] << 8) | (raw[p + 14] << 16) | (raw[p + 15] << 24);
+                bits = raw[p + 22] | (raw[p + 23] << 8);
+            } else if (!memcmp(raw + p, "data", 4)) {
+                if (p + 8 + clen > got)
+                    clen = (uint32_t)(got - p - 8);
+                pcm = (const int16_t *)(raw + p + 8);
+                samples = (int)(clen / 2);
+                break;
+            }
+            p += 8 + clen + (clen & 1);
+        }
+    }
+
+    if (!pcm || channels != 1 || rate != 16000 || bits != 16) {
+        LOG_ERROR("STT: %s must be 16 kHz mono PCM16 (got %d ch, %d Hz, %d bit)", path, channels, rate, bits);
+        heap_caps_free(raw);
+        return -1;
+    }
+
+    LOG_INFO("STT: decoding bundled clip %s (%d samples, %.2f s)", path, samples, (float)samples / 16000.0f);
+    int n = transcribe(pcm, samples, lastText, sizeof(lastText));
+    heap_caps_free(raw);
+
+    if (n <= 0) {
+        LOG_WARN("STT: empty transcript for bundled clip");
+        return 0;
+    }
+    LOG_INFO("STT clip transcript: \"%s\"", lastText);
+    return n;
+}
+
+void SpeechToTextModule::sendTranscript(const char *text)
+{
+    if (!text || !*text)
+        return;
+
+    meshtastic_MeshPacket *p = router->allocForSending();
+    if (!p) {
+        LOG_WARN("STT: no free packet for transcript");
+        return;
+    }
+
+    ChannelIndex ch = channels.getPrimaryIndex();
+    p->to = NODENUM_BROADCAST;
+    p->channel = ch;
+    p->want_ack = false;
+    p->decoded.portnum = meshtastic_PortNum_TEXT_MESSAGE_APP;
+    p->decoded.dest = p->to;
+
+    size_t len = strlen(text);
+    if (len > meshtastic_Constants_DATA_PAYLOAD_LEN)
+        len = meshtastic_Constants_DATA_PAYLOAD_LEN;
+    memcpy(p->decoded.payload.bytes, text, len);
+    p->decoded.payload.size = len;
+
+    ErrorCode err = service->sendToMesh(p, RX_SRC_LOCAL, true);
+    LOG_INFO("STT: sent transcript on channel %u as TEXT_MESSAGE_APP (err %d)", (unsigned)ch, (int)err);
+}
+
+bool SpeechToTextModule::startCaptureWorker()
+{
+    if (captureTask)
+        return true;
+
+    captureWake = xSemaphoreCreateBinary();
+    if (!captureWake)
+        return false;
+
+    if (xTaskCreatePinnedToCore(captureTaskEntry, "stt_capture", 4096, this, 2, &captureTask, 0) != pdPASS) {
+        captureTask = nullptr;
+        return false;
+    }
+    LOG_INFO("STT: capture worker up on core 0 (4096 byte stack)");
+    return true;
+}
+
+void SpeechToTextModule::captureTaskEntry(void *arg)
+{
+    static_cast<SpeechToTextModule *>(arg)->captureLoop();
+}
+
+uint32_t SpeechToTextModule::captureElapsedMs() const
+{
+    if (!captureActive)
+        return 0;
+    return (uint32_t)(millis() - captureStartedMs);
+}
+
+void SpeechToTextModule::startCapture()
+{
+    if (!captureBuf || !audioInput.isRunning()) {
+        LOG_WARN("STT: talk requested but the microphone is not ready");
+        nextMicRetryMs = millis(); // retry on the next tick instead of failing this press
+        return;
+    }
+    if (captureActive || captureBusy)
+        return;
+
+    captureBusy = true;
+    captureSamples = 0;
+    sttButtonCaptureActive = true;
+    audioInput.flush();
+    captureStartedMs = millis();
+    captureActive = true;
+    LOG_INFO("STT: listening...");
+    xSemaphoreGive(captureWake);
+}
+
+void SpeechToTextModule::stopCapture()
+{
+    if (!captureActive)
+        return;
+    captureActive = false;
+    LOG_INFO("STT: released after %d samples (%.2f s)", captureSamples, (float)captureSamples / 16000.0f);
+}
+
+void SpeechToTextModule::captureLoop()
+{
+    const int maxSamples = STT_MAX_UTTERANCE_SEC * 16000;
+
+    for (;;) {
+        if (xSemaphoreTake(captureWake, portMAX_DELAY) != pdTRUE)
+            continue;
+
+        audioInput.logRawFrames(3);
+
+        int total = 0;
+        while (captureActive && total < maxSamples) {
+            int want = maxSamples - total;
+            if (want > STT_READ_CHUNK)
+                want = STT_READ_CHUNK;
+            int n = audioInput.read(captureBuf + total, want, 100);
+            if (n <= 0) {
+                LOG_WARN("STT: I2S read stalled after %d samples", total);
+                break;
+            }
+            total += n;
+            captureSamples = total;
+        }
+        captureActive = false;
+
+        int16_t pkA = 0, pkB = 0;
+        audioInput.takePeaks(pkA, pkB);
+        int pk = pkA > pkB ? pkA : pkB;
+        LOG_INFO("STT: captured %d samples (%.2f s), slotA peak %d, slotB peak %d", total, (float)total / 16000.0f,
+                 (int)pkA, (int)pkB);
+
+        if (total < STT_MIN_UTTERANCE_SAMPLES) {
+            LOG_WARN("STT: utterance shorter than %.1f s, ignored", STT_MIN_UTTERANCE_SAMPLES / 16000.0f);
+        } else {
+            if (pk < 64)
+                LOG_WARN("STT: microphone looks silent (peak %d) - check ES7243E gain and I2S wiring", pk);
+
+            if (transcribe(captureBuf, total, lastText, sizeof(lastText)) > 0) {
+                LOG_INFO("STT heard: \"%s\"", lastText);
+#if STT_CONFIRM_BEFORE_SEND
+                strncpy(pendingTranscript, lastText, sizeof(pendingTranscript) - 1);
+                pendingTranscript[sizeof(pendingTranscript) - 1] = '\0';
+                pendingAction = 0;
+                pendingFlag = true;
+                pendingRev++;
+                LOG_INFO("STT: transcript held, waiting for SEND / REDO on screen");
+#else
+                sendTranscript(lastText);
+#endif
+            } else {
+                lastText[0] = '\0';
+                LOG_WARN("STT: no transcript produced");
+            }
+        }
+
+        captureBusy = false;
+        sttButtonCaptureActive = false;
+    }
+}
+
+void SpeechToTextModule::bringUp()
+{
+    LOG_INFO("STT: bring-up start");
+    pinMode(BUTTON_PIN, INPUT_PULLUP);
+
+    if (!loadEngine())
+        return;
+
+    if (!startDecodeWorker())
+        LOG_WARN("STT: decode worker unavailable, falling back to loopTask stack");
+
+    if (transcribeWavFile(STT_TEST_CLIP) < 0) {
+        int samples = 16000;
+        int16_t *silence =
+            (int16_t *)heap_caps_aligned_alloc(16, samples * sizeof(int16_t), MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
+        if (silence) {
+            memset(silence, 0, samples * sizeof(int16_t));
+            char text[STT_TEXT_BYTES];
+            transcribe(silence, samples, text, sizeof(text));
+            heap_caps_free(silence);
+        }
+    }
+
+    captureBuf = (int16_t *)heap_caps_aligned_alloc(16, (size_t)STT_MAX_UTTERANCE_SEC * 16000 * sizeof(int16_t),
+                                                    MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
+    if (!captureBuf) {
+        LOG_ERROR("STT: cannot allocate %u byte capture buffer",
+                  (unsigned)((size_t)STT_MAX_UTTERANCE_SEC * 16000 * sizeof(int16_t)));
+        return;
+    }
+
+    if (!audioInput.begin()) {
+        LOG_WARN("STT: microphone unavailable, retrying in the background");
+        nextMicRetryMs = millis() + 3000;
+        return;
+    }
+
+    int probe = audioInput.read(captureBuf, 4000, 500);
+    int16_t probeA = 0, probeB = 0;
+    audioInput.takePeaks(probeA, probeB);
+    LOG_INFO("STT: mic probe read %d samples, slotA peak %d, slotB peak %d", probe, (int)probeA, (int)probeB);
+    audioInput.logRawFrames(3);
+
+    if (!startCaptureWorker())
+        LOG_WARN("STT: capture worker unavailable, talking will not work");
+
+    LOG_INFO("STT: ready - hold the on-screen MIC button (bottom right) and speak English");
+}
+
+int32_t SpeechToTextModule::runOnce()
+{
+    if (selfTestPending) {
+        selfTestPending = false;
+        bringUp();
+        bringUpDone = true;
+        if (!nemo)
+            return disable();
+        return 50;
+    }
+
+    uint32_t now = millis();
+
+    // A failed microphone bring-up is usually an I2C clash with the GT911 touch controller, not a
+    // dead codec. Keep retrying in the background so the button starts working without a reboot.
+    if (nemo && !audioInput.isRunning() && micRetryCount < STT_MIC_RETRIES && (int32_t)(now - nextMicRetryMs) >= 0) {
+        micRetryCount++;
+        nextMicRetryMs = now + 3000;
+        if (audioInput.begin()) {
+            LOG_INFO("STT: microphone recovered on retry %d", micRetryCount);
+            micRetryCount = STT_MIC_RETRIES;
+        } else {
+            LOG_WARN("STT: microphone retry %d/%d failed", micRetryCount, STT_MIC_RETRIES);
+        }
+    }
+
+    // SEND / REDO from the touch UI. Doing the mesh send here keeps it on the module thread.
+    if (pendingFlag && pendingAction) {
+        int action = pendingAction;
+        pendingAction = 0;
+        pendingFlag = false;
+        if (action == 1) {
+            LOG_INFO("STT: confirmed on screen, sending");
+            sendTranscript(pendingTranscript);
+        } else {
+            LOG_WARN("STT: discarded on screen, nothing sent");
+        }
+    }
+
+    bool down = digitalRead(BUTTON_PIN) == LOW;
+
+    if (down) {
+        sttButtonCaptureActive = true;
+        if (!buttonDown) {
+            buttonDown = true;
+            lastReleaseMs = 0;
+            startCapture();
+        }
+    } else {
+        if (buttonDown) {
+            buttonDown = false;
+            stopCapture();
+            lastReleaseMs = now;
+        }
+        // Hold the flag a little past the release so OneButton's trailing click is swallowed too.
+        if (lastReleaseMs && now - lastReleaseMs > 400 && !captureBusy)
+            sttButtonCaptureActive = false;
+    }
+    return 30;
+}
+
+#endif
