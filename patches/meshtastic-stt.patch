+    C.qu = (int8_t *)tasr_alloc((size_t)H * T * dhp, 0);
+    C.qv = (int8_t *)tasr_alloc((size_t)H * T * dhp, 0);
+    C.k8 = (int8_t *)tasr_alloc((size_t)H * T * dhp, 0);
+    C.vt = (int8_t *)tasr_alloc((size_t)H * dh * C.Tp, 0);
